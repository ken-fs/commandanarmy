---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta      — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
// Official game art (developer-uploaded Roblox media) — the homepage's
// strongest trust signal. Text-only heroes read as low-effort next to a real
// screenshot of the game, and this is the first thing a visitor sees.
import heroShot from '~/assets/brand/shot-1.png';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
// Typed straight from en.json (HomeUi) — no `as any`: a renamed key now
// fails typecheck instead of silently blanking the block (check-i18n only
// compares locale↔en, not component↔en; tests/home-ui.test.ts pins the
// access surface at the JSON level too).
const home = ui.home;
const shared = ui.shared;

const recent = await getRecentEntries(locale, 6);

// Per-field fallbacks: a locale JSON whose meta object exists but lacks
// title/description must not pass undefined into BaseLayout (title.includes
// crashes the build) — same spirit as the ?? defaults below.
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
// Section namespaces come from en.json verbatim (getUi deep-merges non-en
// locales over en), so every key is guaranteed present — no per-section
// `{ cards: [] }`-style fallbacks and no hardcoded English anywhere. A key
// missing from en.json itself is a build-time typecheck failure, not a
// blanked section at runtime.
const hero: HomeUi['hero'] = home.hero;
const updates: HomeUi['updates'] = home.updates;
const start: HomeUi['start'] = home.start;
const popular: HomeUi['popular'] = home.popular;
const explore: HomeUi['explore'] = home.explore;
const closingCta: HomeUi['closingCta'] = home.closingCta;

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section class="relative flex min-h-[52vh] items-center overflow-hidden border-b border-border md:min-h-[68vh]">
    {/* Subtle theme-color gradient backdrop — gives the hero a visual anchor
        without requiring an image asset. Sits behind the watermark. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-nav/8 via-transparent to-transparent"
    />
    {/* The upstream hero used a giant faded game-name watermark as a visual
        anchor "without requiring an image asset". This fork ships a real
        screenshot instead, so the watermark is gone — two competing visual
        anchors read as clutter, and the faint text sat directly behind the
        headline. */}

    <div class="relative mx-auto w-full max-w-7xl px-4 py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center lg:gap-14">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{hero.badge}</p>
          <h1
            class="mt-3 max-w-3xl bg-gradient-to-r from-foreground to-foreground/60 bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {hero.title}
          </h1>
          <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{hero.description}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              hero.ctaPrimary && (
                <a
                  href={site.social.official}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary"
                >
                  <Icon name="lucide:play" class="mr-2 h-4 w-4" />
                  {hero.ctaPrimary}
                </a>
              )
            }
            {
              hero.ctaSecondary && (
                <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="btn-outline">
                  {hero.ctaSecondary}
                </a>
              )
            }
          </div>
        </div>

        {/* Official in-game screenshot. Eager + high priority: on mobile this
            is the LCP element, and lazy-loading it would delay the one paint
            that Core Web Vitals actually measures. Source is 768px wide, so
            widths cap there — no upscaling. */}
        <div class="relative">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -inset-3 rounded-2xl bg-gradient-to-br from-nav/15 to-transparent blur-2xl"
          />
          <Image
            src={heroShot}
            alt={`A shield wall of armoured units in formation during a match in ${site.game.name}`}
            widths={[400, 768]}
            sizes="(max-width: 1023px) 100vw, 620px"
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative w-full rounded-xl border border-border shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && (
    <VideoSection videoId={hero.videoId} title={`${site.game.name} ${shared.gameTrailer}`} />
  )}

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="text-sm text-foreground hover:text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">
                      {parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {trendingLinks.length > 0 && (
        <aside>
          <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{popular.badge}</p>
          <h2 class="mt-1 text-2xl font-bold">{popular.title}</h2>
          <ul class="mt-4 space-y-2">
            {trendingLinks.map((link: QuickLink) => {
              const href = trendingHref(link);
              const label = trendingLabel(link);
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium transition hover:border-nav/50"
                    >
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </a>
                  ) : (
                    <div class="flex items-center gap-2 rounded-md border bg-card p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <h2 class="text-2xl font-bold">{explore.title}</h2>
        <p class="mt-1 text-sm text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="rounded-xl border bg-card p-8 text-center md:p-12">
          <h2 class="text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
